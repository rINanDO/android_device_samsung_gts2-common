#============= tee ==============
allow tee device:chr_file rw_file_perms;
allow tee efs_file:dir r_dir_perms;
allow tee efs_file:file r_file_perms;
allow tee init:unix_stream_socket connectto;
allow tee property_socket:sock_file write;
allow tee system_prop:property_service set;
# /efs/prov (or /mnt/vendor/efs/prov) is labeled prov_efs_file by
# device/samsung_slsi/sepolicy/common/vendor/file_contexts. The old
# "unlabeled:dir search" rule below was a workaround from when this path
# had no file_contexts entry yet; now that it's properly labeled, grant
# the real type instead (confirmed live via AVC: McDaemon.Server denied
# { search } on name="prov" tcontext=u:object_r:prov_efs_file:s0 - this
# blocks generateChallenge, which gates fingerprint enroll/auth).
allow tee prov_efs_file:dir search;

